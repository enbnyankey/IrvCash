<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Forgot Password | PettyCash</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <style>
      .btn {
        display: inline-block;
        padding: 10px 24px;
        background: #2563eb;
        color: #fff;
        border-radius: 6px;
        text-decoration: none;
        font-weight: bold;
      }
      .btn:hover {
        background: #1d4ed8;
      }
    </style>
  </head>
  <body style="background: #f3f4f6; font-family: sans-serif;">
    <div style="max-width: 400px; margin: 40px auto 0 auto; background: #fff; box-shadow: 0 2px 8px rgba(0,0,0,0.1); border-radius: 12px; overflow: hidden; border: 1px solid #e5e7eb;">
      <div style="background: #2563eb; padding: 16px; text-align: center;">
        <img
          src="https://static.vecteezy.com/system/resources/previews/008/214/517/non_2x/abstract-geometric-logo-or-infinity-line-logo-for-your-company-free-vector.jpg"
          alt="PettyCash Logo"
          style="margin: 0 auto; height: 64px; width: 64px; border-radius: 50%;"
        />
        <h1 style="color: #fff; font-size: 20px; font-weight: 600; margin-top: 8px;">PettyCash Notification</h1>
      </div>
      <div style="padding: 24px; color: #374151;">
        <h2 style="font-size: 18px; font-weight: 600; margin-bottom: 8px;">Hello, {{name}}!</h2>
        <p style="margin-bottom: 16px;">{{message}}</p>
        {{#if actionRequired}}
        <div style="display:flex; justify-content:space-between;  margin-top: 24px;">
          {{!-- items-align: center; --}}
          <a href="{{actionLink}}" class="btn">{{actionText}}</a>
        </div>
        {{/if}}
        <p style="margin-top: 24px; font-size: 14px; color: #6b7280;">If you have any questions, just reply to this email.</p>
        <p style="margin-top: 4px; font-size: 12px; color: #9ca3af;">This email was sent automatically. Please do not reply.</p>
      </div>
    </div>
  </body>
</html>