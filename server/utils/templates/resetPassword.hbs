<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Password Reset | PettyCash</title>
</head>
<body style="margin: 0; padding: 0; background-color: #f8fafc; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
  <table role="presentation" style="width: 100%; border-collapse: collapse; background-color: #f8fafc;">
    <tr>
      <td style="padding: 40px 20px;">
        <table role="presentation" style="max-width: 500px; margin: 0 auto; background-color: #ffffff; border-radius: 16px; box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05); border: 1px solid #e2e8f0;">
          
          <!-- Header with Logo -->
          <tr>
            <td style="text-align: center; padding: 32px 32px 16px 32px;">
              <div style="align-items:center; display: flex; justify-content:space-around; width: 48px; height: 48px; background-color: #3b82f6; border-radius: 12px; position: relative;">
                <span style="color: #ffffff; font-size: 24px; font-weight: bold; line-height: 48px;">P</span>
              </div>
              <h1 style="margin: 12px 0 0 0; color: #1e293b; font-size: 24px; font-weight: 600;">PettyCash</h1>
            </td>
          </tr>

          <!-- Illustration Area -->
          <tr>
            <td style="text-align: center; padding: 0 32px 24px 32px;">
              <div style="background-color: #f1f5f9; border-radius: 12px; padding: 32px; margin-bottom: 24px;">
                <div style="font-size: 48px; margin-bottom: 8px;">🔐</div>
                <div style="color: #64748b; font-size: 14px;">Password Reset Request</div>
              </div>
            </td>
          </tr>

          <!-- Main Content -->
          <tr>
            <td style="padding: 0 32px;">
              <h2 style="margin: 0 0 16px 0; color: #1e293b; font-size: 20px; font-weight: 600; text-align: center;">Hi {{name}},</h2>
              
              <p style="margin: 0 0 16px 0; color: #475569; font-size: 16px; line-height: 1.5; text-align: center;">
                Need to reset password? No problem.<br>
                Just click the button below.
              </p>
            </td>
          </tr>

          <!-- CTA Button -->
          <tr>
            <td style="padding: 24px 32px; text-align: center;">
              <a href="{{resetLink}}" style="display: inline-block; background-color: #3b82f6; color: #ffffff; text-decoration: none; padding: 14px 32px; border-radius: 8px; font-weight: 600; font-size: 16px; box-shadow: 0 2px 4px rgba(59, 130, 246, 0.3);">
                Reset password →
              </a>
            </td>
          </tr>

          <!-- Footer Content -->
          <tr>
            <td style="padding: 24px 32px 32px 32px; border-top: 1px solid #e2e8f0;">
              <p style="margin: 0 0 12px 0; color: #64748b; font-size: 14px; line-height: 1.4;">
                If you did not initiate this request, please contact us at 
                <a href="mailto:support@pettycash.com" style="color: #3b82f6; text-decoration: none;">support@pettycash.com</a>
              </p>
              
              <p style="margin: 12px 0 16px 0; color: #64748b; font-size: 14px;">
                Thanks,<br>
                The PettyCash Team
              </p>
            </td>
          </tr>

          <!-- Copyright and Social -->
          <tr>
            <td style="padding: 0 32px 32px 32px;">
              <table role="presentation" style="width: 100%; border-collapse: collapse;">
                <tr>
                  <td style="text-align: left;">
                    <p style="margin: 0; color: #94a3b8; font-size: 12px;">© 2025 PettyCash</p>
                  </td>
                  <td style="text-align: right;">
                    <table role="presentation" style="display: inline-block; border-collapse: collapse;">
                      <tr>
                        <td style="padding-right: 8px;">
                          <a href="#" style="display: inline-block; width: 24px; height: 24px; background-color: #3b82f6; border-radius: 50%; text-align: center; line-height: 24px; text-decoration: none;">
                            <span style="color: #ffffff; font-size: 12px; font-weight: bold;">f</span>
                          </a>
                        </td>
                        <td style="padding-right: 8px;">
                          <a href="#" style="display: inline-block; width: 24px; height: 24px; background-color: #06b6d4; border-radius: 50%; text-align: center; line-height: 24px; text-decoration: none;">
                            <span style="color: #ffffff; font-size: 12px; font-weight: bold;">@</span>
                          </a>
                        </td>
                        <td>
                          <a href="#" style="display: inline-block; width: 24px; height: 24px; background-color: #0ea5e9; border-radius: 50%; text-align: center; line-height: 24px; text-decoration: none;">
                            <span style="color: #ffffff; font-size: 12px; font-weight: bold;">in</span>
                          </a>
                        </td>
                      </tr>
                    </table>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>
</body>
</html>